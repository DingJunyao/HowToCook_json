  "steps": [
    {
      "content": "将糯米粉、粘米粉、蒸肉粉、细辣椒粉、5 克盐、白胡椒粉倒一起搅匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸭子让热心摊主剁成蒸煮块，姜切片，蒜子剥皮，五花肉切片即可",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅凉油煸炒五花肉出油，再加食用油烧热，下入鸭子煸炒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸭子煸炒到表皮焦变色，下入姜蒜和盐继续煸炒香味",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关小火倒入米粉翻炒，鸭肉均匀裹满米粉子，加入开水，少量多次的加，边加边翻炒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻炒鸭肉和米粉有湿感，铲出入碗中，高压锅放水蒸 20-25 分钟",
      "duration_minutes": 25.0,
      "tips": ""
    },
    {
      "content": "出锅前撒点葱花即可享用了",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "鸭子品种不限，这里买的是水鸭，价格 24。",
    "蒸 20 分钟，是老鸭的话，蒸一个小时以上。",
    "第一步中粘米粉是主要的粉子，糯米粉是加软糯口感，蒸肉粉是加五香味道，辣椒粉和胡椒粉是加复合香味。"
  ],
  "description": "湖南两祁地区特色菜品，逢年过节家家桌上有。鸭肉被米粉子包裹，入口咸香回味悠长可解乡愁。"
