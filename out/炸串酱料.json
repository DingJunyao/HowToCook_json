  "steps": [
    {
      "content": "干辣椒面、孜然粉、胡椒粉、五香粉、花椒粉、十三香、麻辣鲜、白芝麻、食盐、鸡精，在容器内混合，搅拌均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅里烧热油，油的用量以在容器内没过所有原材料为佳。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "分三次淋入热油，每次 1/3，同时搅拌。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "最后放入香油 10ml，生抽 10ml，花椒油 10ml，蚝油 10ml。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "最后一步的调味可按自己喜好添加。",
    "不得一次性倒入所有热油，必须分次倒入并搅拌。",
    "原料可按比例缩减。"
  ],
  "description": "炸串酱料，号称淋袜子都好吃，新手友好，预计用时 10 分钟。"
