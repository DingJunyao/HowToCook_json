  "steps": [
    {
      "content": "五花肉切成长宽 2.5 cm 的小块",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "冷水放料酒姜片，五花肉放入开火慢慢加入到水沸腾后捞出",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "玫瑰腐乳块和腐乳汁碾成泥，加冰糖、老抽调成酱汁",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅冷油爆香葱姜，下肉块煸到金黄",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入腐乳酱炒匀加热水焖煮",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小火慢炖 40 分钟",
      "duration_minutes": 40.0,
      "tips": ""
    },
    {
      "content": "大火收汁，看到汤汁冒浓稠鱼眼泡时关火",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "建议用单晶冰糖",
    "腐乳自带咸鲜，不用额外放盐",
    "大火收汁时要不断晃动锅体避免粘底",
    "参考资料：【步骤图】腐乳肉的做法腐乳肉的做法步骤菜谱_下厨房(https://www.xiachufang.com/recipe/102507/)"
  ],
  "description": "腐乳肉精选五花肉与红腐乳缠绵共舞。腐乳特有的酒香豆香渗入肉纹，经慢火煨炖化作琥珀色的温柔。入口即化的肉质裹着微甜咸鲜的酱汁，堪称舌尖上的风月宝鉴～"
