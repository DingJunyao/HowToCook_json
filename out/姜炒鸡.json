  "steps": [
    {
      "content": "鸡尽量剁成 1cm 的小块，洗净后滤干，再放生抽腌和料酒腌制 30 分钟",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "大先热锅到微微冒烟，放入食用油，等 5 秒",
      "duration_minutes": 0.08,
      "tips": ""
    },
    {
      "content": "下入姜片后转中火炒 30 秒，",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "下入鸡块翻炒 3 分钟，炒干水分，炒出鸡油",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "放入各种剁碎的辣椒和大蒜子，加盐和老抽继续翻炒 30 秒",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "倒入啤酒，中小火焖 2 分钟",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "大火收汁盛盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "姜炒鸡是一道湖南口味菜，下饭五颗星，食材平平无奇又十分容易烹制，一学就会。"
