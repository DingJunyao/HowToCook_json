  "steps": [
    {
      "content": "娃娃菜洗净, 竖着切开切成段。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "葱 3g 切 小段。蒜 10g 切片。姜 10g 切小片。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "皮蛋切成丁, 火腿肠或者午餐肉切成丁（1cm 大小的丁）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "金针菇洗净撕开",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "烧热水娃娃菜放进去十秒钟出一下水捞出。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅凉油, 加热锅倒入油过一遍就倒出来, 重新倒入一点油。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "调至小火加入葱姜蒜，煎炒出香味即可。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入适 300g 清水（水量没过娃娃菜即可）, 放入娃娃菜, 金针菇, 午餐肉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入调味料蚝油、糖、盐、味精烧开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "煮 3 分钟, 煮开后开始装盘, 盛出娃娃菜后皮蛋放在上面把汤汁浇上去就可以了",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "素菜、减肥餐"
