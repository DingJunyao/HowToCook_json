  "steps": [
    {
      "content": "西红柿切成小丁、鸡蛋打入碗中搅拌、豆腐切块备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，放入姜片 5 S 后倒入入西红柿翻炒 30 S",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入开水，汤水烧开，60 S 后到入鸡蛋液、豆腐块",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "汤水重新烧开后，加入水淀粉，沿一个方向搅拌 2 圈",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入鸡精、盐、香葱，30 S 后起锅",
      "duration_minutes": 0.5,
      "tips": ""
    }
