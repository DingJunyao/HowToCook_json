  "steps": [
    {
      "content": "将酱油、糖和醋混合在一起,搅匀料汁备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "另一个碗中加入鸡肉、鸡蛋、1/2 料汁和压碎的丽滋饼干。搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "空气炸锅用箔纸碗铺底，加入肉饼混合物，将剩余的料汁均匀的倒在上面",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "350°F(177°C) 炸40 分钟。最好在米饭上食用",
      "duration_minutes": 40.0,
      "tips": ""
    },
    {
      "content": "在外观呈金黄酥脆后出锅，切块盛盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
