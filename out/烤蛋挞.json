  "steps": [
    {
      "content": "将碗置于克数称上 称量 450 克 淡奶油（淡奶油密度在此处记为 1 ）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入 80 克白砂糖 （甜度中等 可按个人口味增减 建议范围 60-100 克）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入 200 克牛奶 （牛奶密度在此处记为 1 ）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取 8 个蛋黄加入 蛋清可留作他用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "均匀搅拌所有材料直至白砂糖全部融化",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "使用网筛对搅拌完成的食材进行过滤 滤除鸡蛋黏膜 鸡蛋壳 未融化的白砂糖 结块的淡奶油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "此时请将烤箱设置 220 摄氏度开始预热（约 10 分钟） 记得拿出烤盘",
      "duration_minutes": 10.0,
      "tips": ""
    },
    {
      "content": "将蛋挞皮以 0.5 厘米的间隔均匀放置于烤盘中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将过滤完成的食材倒入蛋挞皮中 液面距离蛋挞皮上沿 0.5 厘米即可不宜过多",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "截止此步骤 半成品蛋挞的制作已经完成 可直接放入冰箱速冻 12 小时以上保存",
      "duration_minutes": 720.0,
      "tips": ""
    },
    {
      "content": "将半成品蛋挞放入烤箱中进行烤制 温度为 200 摄氏度 时间为 25 分钟",
      "duration_minutes": 25.0,
      "tips": ""
    },
    {
      "content": "烤制结束后即可食用",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "该配方为整包蛋挞皮所需量 填充后可直接冷冻保存",
    "操作时 请务必小心烤箱高温 防止烫伤"
  ],
  "description": "烤蛋挞是一道简单易于制作的甜品 且半成品可置于冰箱冷冻长时间保存 随吃随取 出品时间约 1 小时"
}