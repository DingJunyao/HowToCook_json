  "steps": [
    {
      "content": "拿出蒜头掰 2 个小蒜头去皮",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "拿出砧板剁碎小蒜头、小米椒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "拿出碗倒入花生油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "油热放入其他配料和小葱，等到香料变焦，捞出扔掉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "拿出铁锅将碗内的油放入加热 2 分钟（菜籽油烧至冒烟）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "往空碗加入干辣椒面、白芝麻、蒜末、小米椒、盐、五香粉、草蔻作为\"调料\"",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火将油温冷却至 210 摄氏度",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将锅内热油倒入碗内并用勺子搅拌即可",
      "duration_minutes": null,
      "tips": "可以在 165 摄氏度时加入同样\"调料\"的碗最后进行混合进行增辣"
    },
    {
      "content": "倒入热油稍微搅拌后放入白醋，此时会重新沸腾。继续进行搅拌，白醋增香。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "油泼辣子冷却到温热放白糖和味精，白糖可以使辣味柔和，不会那么地呛口",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "五香粉、草蔻作为\"调料\"加入，可以增加香味，使油泼辣子更香"
  ],
  "description": "制作耗时 10 分钟"
}