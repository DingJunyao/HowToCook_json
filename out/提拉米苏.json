  "steps": [
    {
      "content": "分离蛋黄蛋清",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "盛有蛋白的碗中加 10g 白砂糖湿性打发",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "盛有蛋黄的碗中将 40g 白砂糖分三次加入，搅拌至均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "蛋黄中分三次加入马斯卡彭芝士，搅拌至均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "蛋黄中最后加入朗姆酒，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将打发好的蛋白分三次加入蛋黄芝士液中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "手指饼干两面浸湿咖啡液，平铺入容器",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "两层芝士液两层饼干交替放入容器",
      "duration_minutes": null,
      "tips": "这一步按照大家意愿及容器高度酌情处理"
    },
    {
      "content": "放入冰箱冷藏四个小时",
      "duration_minutes": null,
      "tips": "心急的小伙伴可以提早拿出来"
    },
    {
      "content": "取出后在表面筛上可可粉，即可享用啦",
      "duration_minutes": null,
      "tips": ""
    }
  ],
