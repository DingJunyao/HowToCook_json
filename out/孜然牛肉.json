  "steps": [
    {
      "content": "首先将小米椒切碎，和孜然粒一起放入捣药罐捣碎成颗粒，这样更入味。",
      "duration_minutes": null,
      "tips": "如果时间紧张可跳过捣碎步骤"
    },
    {
      "content": "青椒切头去籽，切成丝。葱切段。",
      "duration_minutes": null,
      "tips": "喜欢辣的可不去籽"
    },
    {
      "content": "牛肉提前解冻，过一边水洗干净，晾干或用厨用纸吸干，将牛肉顺着纹理切成片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "然后进行腌肉，加入生抽，淀粉，油，均匀搅拌，静止 30 分钟。",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "热锅下油，放入葱，爆出香味后放入腌好的牛肉煸炒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "牛肉变色后均匀放入孜然辣椒颗粒并炒熟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "然后下入青椒丝，断生后放盐",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火炒 1 分钟后关火再翻炒 30 秒保证受热均匀即可出锅",
      "duration_minutes": 1.5,
      "tips": ""
    }
  ],
