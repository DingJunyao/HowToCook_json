  "steps": [
    {
      "content": "五花肉切成厚度不超过 2cm 长的块，并串成串。（）",
      "duration_minutes": null,
      "tips": "五花肉可以预先腌制一下，味道更佳"
    },
    {
      "content": "大葱切成 5cm 长的葱段，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "芝麻酱加 10ml 温水调稀，与甜面酱混合均匀，备用",
      "duration_minutes": null,
      "tips": "可以换成芝麻盐"
    },
    {
      "content": "点燃炭火，等待炭火烧至通红无明火状态（约 15 分钟）",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "将五花肉串均匀摆在在烤网上，烤至底面焦黄出油后翻面",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "继续烤制约 2 - 3 分钟，至两面焦黄、边缘微焦后取下",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "取一张小薄面饼平铺，抹上 3 - 4g 混合酱料",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放上烤好的肉片和 1 - 2 段大葱，卷起即可食用",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "五花肉切片时建议放入冰箱冷冻 30 分钟后再切，更易切块。",
    "炭火烤制风味优于燃气，有条件建议使用木炭。",
    "酱料可根据个人口味调整芝麻酱与甜面酱的比例，也可以换成芝麻盐。"
  ],
  "total_time_minutes": null
