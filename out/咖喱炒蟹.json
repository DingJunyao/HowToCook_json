  "steps": [
    {
      "content": "肉蟹掀盖后对半砍开，蟹钳用刀背轻轻拍裂，切口和蟹钳蘸一下生粉，不要太多。撒 5g 生粉到蟹盖中，盖住蟹黄，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "洋葱切成洋葱碎，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大蒜切碎，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "烧一壶开水，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，倒入约 20ml 食用油，等待 10 秒让油温升高",
      "duration_minutes": 0.17,
      "tips": ""
    },
    {
      "content": "将螃蟹切口朝下，轻轻放入锅中，煎 20 秒，这一步主要是封住蟹黄，蟹肉。然后翻面，每面煎 10 秒。煎完将螃蟹取出备用",
      "duration_minutes": 0.67,
      "tips": ""
    },
    {
      "content": "将螃蟹盖放入锅中，使用勺子舀起锅中热油泼到蟹盖中，煎封住蟹盖中的蟹黄，煎 20 秒后取出备用",
      "duration_minutes": 0.33,
      "tips": ""
    },
    {
      "content": "不用刷锅，再倒入 10ml 食用油，大火让油温升高至轻微冒烟，将大蒜末，洋葱碎倒入，炒 10 秒钟",
      "duration_minutes": 0.17,
      "tips": ""
    },
    {
      "content": "将咖喱块放入锅中炒化（10 秒），放入煎好的螃蟹，翻炒均匀",
      "duration_minutes": 0.17,
      "tips": ""
    },
    {
      "content": "倒入开水 300ml，焖煮 3 分钟。",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "焖煮完后，倒入椰浆和蛋清，关火，关火后不断翻炒，一直到酱汁变浓稠。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "出锅",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "做法参考：[十几年澳门厨房佬教学挂汁的咖喱蟹怎么做](https://www.bilibili.com/video/BV1Nq4y1W7K9)"
  ],
  "description": "第一次吃咖喱炒蟹是在泰国的建兴酒家中餐厅，爆肉的螃蟹挂满有蟹黄味道的咖喱，味道真的绝，喜欢吃海鲜的程序员绝对不能错过。操作简单，对沿海的程序员非常友好。"
