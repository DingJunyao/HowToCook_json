  "steps": [
    {
      "content": "鱼处理好后洗净，放入大碗中，倒入料酒、10g 姜片、5g 盐，腌制 15 分钟",
      "duration_minutes": null,
      "tips": "特别注意肚内的血丝、不洗干净会有腥味"
    },
    {
      "content": "豆腐切块，放入凉水浸泡 5 分钟，捞出备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "煎鱼前，先用生姜片擦一下锅防止粘锅，倒入油（油量为 15ml * 鱼的条数 ），烧热后放入鱼煎 2~3 分钟，期间需要晃动一下鱼，防止粘底，且需要翻一次身",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "待鱼全部煎好之后，倒入开水、5ml 料酒、姜片，小火转至大火，盖上锅盖、大火煮 10 分钟（水要稍微多一些，后面会蒸发掉一些）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "见汤变白后倒入准备好的豆腐，调中火再煮 5 分钟，加入 10g 盐、3g 胡椒粉调味，最后撒上葱花出锅",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "昂刺鱼/沙光鱼 豆腐汤 刺少 肉嫩 营养丰盛、适合任何年龄的小伙伴"
