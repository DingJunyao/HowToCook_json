  "steps": [
    {
      "content": "开洋泡入 50 度温水中，加入 10ml 料酒去腥，泡 10 分钟后取出沥干水分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "葱，香菜洗净，切成 5cm 长的段，擦干表面水份",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "洋葱切成丝，在锅里用热水煮 5 分钟，取出沥干水份",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "姜去皮，切成片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅里倒入全部油，放入上述预处理好的材料，开中小火炸 20 分钟",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "渣后的开洋葱渣也可以食用，葱油可以滤掉这些料渣，也可以保留",
    "开洋可以极大提升葱油鲜香，并增加鲜甜风味"
  ],
  "description": "葱油是用热油萃取以葱为主的各类香辛料得到的产物，可以用来调制肉馅，做凉拌菜，在热炒菜中作为出锅明油使用。"
