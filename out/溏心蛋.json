  "steps": [
    {
      "content": "将鸡蛋放入电锅中。鸡蛋不可互相堆叠，应皆在底部，并留有空间可以晃动",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入淹过鸡蛋约 2 公分的冷水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开盖，使用最大功率加热至水滚起（大约 85 - 95 度，稍微滚动，不需完全沸腾）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火，盖上盖子，让鸡蛋静置。想要中央有流动的蛋黄，需静置 6 分钟；若想要完全煮熟的易碎蛋黄，需静置 10 分钟",
      "duration_minutes": 10.0,
      "tips": ""
    },
    {
      "content": "沥干水分，用冷水冲洗鸡蛋约 1 分钟，即可去壳食用。",
      "duration_minutes": 1.0,
      "tips": ""
    }
  ],
  "tips": [
    "如果觉得鸡蛋不够熟的小伙伴可以依照自己的喜好添加更多的水。",
    "警告：溏心蛋有沙门氏菌感染的风险。不建议静置 5 分钟以内。"
  ],
  "description": "喜欢健身的小伙伴可以在每颗鸡蛋中获得 6 克蛋白质。大约 15 分钟可以完成制作。"
