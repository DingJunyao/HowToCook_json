  "steps": [
    {
      "content": "起锅烧热水，放入排骨、姜片、料酒，煮开后用勺子舀去白色油沫，2-3 分钟后出锅",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "冷水清洗排骨，清洗 2-3 遍",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小火起锅，加入食用油，加入白砂糖 ，轻轻搅拌到糖水变成黄色",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入排骨翻炒 30 S 后，加入生抽、蚝油、五香粉、蒜、小米椒后翻炒 30 S 后，加入清水没过排骨",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火煮 30 分钟，加入老抽上色，再煮 10 分钟",
      "duration_minutes": 40.0,
      "tips": ""
    },
    {
      "content": "起锅摆盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "增加味道的可以考虑加入豆瓣酱、番茄酱等",
    "大火煮时间可以根据每个人情况做调整",
    "煮排骨期间，可以顺道放入 2-3 个 鸡蛋一起煮，做成简易版卤蛋"
  ],
  "description": "酱排骨其色泽酱红，肉质酥烂，骨香浓郁，汁浓味鲜，咸中带甜。"
}