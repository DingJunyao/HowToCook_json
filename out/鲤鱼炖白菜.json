  "steps": [
    {
      "content": "鲤鱼清洗干净，改刀（在鱼身上多划几个伤口，方便入味）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "娃娃菜清洗干净放入盘中备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加油，等油热放入“少盐” “姜” “蒜” “郫县豆瓣酱” “桂皮” “八角” 炒出香味",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "把鱼放锅里煎（3 分钟）每（30 秒）需要翻面",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "加入“水”（水量尽量和鱼平齐，可以少一点点） 放入 “生抽” “老抽” “娃娃菜”",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火炖 15-20 分钟，汤汁快干时添加 “盐” 即可出锅",
      "duration_minutes": 20.0,
      "tips": ""
    }
  ],
  "tips": [
    "调料根据鱼的大小进行换算。",
    "也可以放一些粉条，粉条先凉水/热水，需要泡软，可以和娃娃菜一起放入"
  ],
  "description": ""
