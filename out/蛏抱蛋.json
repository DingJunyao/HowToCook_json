  "steps": [
    {
      "content": "烧开水，将蛏子放入水中，水煮 2 分钟后，捞上来去壳，放入大碗",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "往大碗中加入洋葱、生抽、料酒、鸡精、生粉后，充分搅拌",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "往大碗中打入 2 个 鸡蛋，继续搅拌",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，倒入碗中蛏子，煎炸至单面金黄后，翻面继续煎炸",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "更多情况下，福州当地会选用马蹄（解腻）和马铃薯（洗油），因为疫情期间买不到，所以选用了凤梨",
    "闽菜以甜为主，如果吃不惯的可以放弃白糖",
    "可以通过勺子敲打瘦肉块，听到声响来判断是否炸透瘦肉"
  ],
  "description": "蛏抱蛋，是流行于福建省福州地区的传统家常菜"
}