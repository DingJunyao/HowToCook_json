  "steps": [
    {
      "content": "起锅加 7 成水，水开，上蒸篦子",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将挂面，均匀铺开放置，淋 5ml 油并抹匀，蒸 15 分钟",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "将挂面和蒸篦子取出，放置一边，并倒掉锅中的水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "五花肉，切成 2mm 厚度的肉片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "蒜薹，切成 3cm 段",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "葱，切成 0.2cm 薄片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "姜，切成 1mm x 1mm x 3cm 的细丝",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "蒜，放在砧板上拍碎，切成 1mm 的粒度",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅，烧干水分，加 3ml 食用油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "手持锅柄，摇晃锅，使食用油充分挂满锅的 2/3",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "中火，加入肉片，翻炒 1 分钟",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "加入葱姜蒜，料酒，继续翻炒 1 分钟",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "将蒜薹段，放入锅中，翻炒 1 分钟",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "开始调味，加入老抽、生抽、蚝油、盐、鸡精、十三香，翻炒 1 分钟",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "加入 500ML 水，没过蔬菜，炖煮 1 分钟",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "将蒸好的挂面放入，不断搅拌 3 分钟，待挂面全部均匀上色，关火",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "将搅拌好的挂面和菜，全部倒入额外的盆中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅，加冷水 7 成，放上蒸篦子，将拌好的面条和菜，均匀的铺在上面",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "水开后，大火烧 15 分钟，出锅",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "淋上 10g 的麻油，即可食用",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "挂面的粗细与口感：细的、圆的 （超市大部分都是这种，口感更加劲道）；宽的、扁的 （口感比较软）"
  ],
  "description": "河南蒸面条是一道在河南坊间流行的小吃，也可以用家里的挂面制作。\n简单来讲，是先将挂面裹油放入蒸笼蒸熟，再加蔬菜配以调料炒，最后二次蒸制，以达到入味劲道的效果。"
}