  "steps": [
    {
      "content": "梅菜放到清水中，浸泡 1 小时",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中倒入 50 ml 食用油，将整个五花肉猪皮朝下，放到锅中 1 分钟 ，取出挂掉猪皮 【可选】",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入开水，放入五花肉，大火煮 20 分钟 （筷子可以插进五花肉），取出五花肉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在五花肉表面涂抹均匀老抽、五香粉、白砂糖，放置 15 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，加入五花肉，中火油炸直至两面金黄色（3-5 分钟）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，倒入梅菜，加上小米椒、蒜蓉、鸡精、食用盐后翻炒，直至炒干梅干菜水分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "五花肉切片（后端 0.5-1 cm）,放在大碗中，散上梅干菜",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "中火蒸 45 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "拿个盘子倒盖在五花肉大碗中，将五花肉倒在盘子中",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "制作过程中发现，脆皮五花肉真香 Orz~",
    "不喜欢吃甜的可以去掉白砂糖，不影响主流程",
    "倒数第二个步骤，可以根据个人喜好调整时间",
    "炒干梅干菜的作用是为了后续吸油（盲猜）"
  ],
  "description": "梅菜扣肉造型别致、大方得体，颜色酱红油亮，汤汁黏稠鲜美，扣肉肥而不腻，食之软烂醇香。"
}