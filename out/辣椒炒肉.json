  "steps": [
    {
      "content": "将青椒洗净，去除青椒把以及青椒籽，再用滚刀手法切好备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大蒜用刀拍一下，再横切成蒜瓣，生姜切碎成姜末。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将猪瘦肉切成肉片（顺着猪肉的纹理切，即刀和肉的纹理呈水平线，出来的肉片，纹路呈“川”字）。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将切好的猪肉洗净，放入空碗，再加入计算好的生抽、蚝油、盐搅拌均匀，腌制 10 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅，不用倒油，把切好的青椒放入锅中，大火干煸至虎皮状后，再加 2g盐继续翻炒 1 分钟 后捞起。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "不用洗锅，大火热锅，加入份数 * 8ml油，等待 30s，加入蒜瓣、姜末翻炒 15s。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入腌制好的猪肉倒入锅内翻炒 2 分钟，再加入干煸过的青椒翻炒 1 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "根据个人口味喜好加入豆豉，最后加入酱油，继续翻炒 30s。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "出锅，盛盘。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "辣椒只能选择青椒，螺丝椒为最优解，切勿选择其他品种辣椒！"
  ],
  "description": "注意：本道菜需要一定料理基础，不推荐新手尝试。"
