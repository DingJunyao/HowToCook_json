  "steps": [
    {
      "content": "鸡肝清洗，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "蒜苗清洗，切段，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大葱清洗，取 100g 切段，取 50g 切片，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "姜清洗，取 70g 切片， 取 50g 切丁，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "清洗后的鸡肝放入锅内，加入凉水淹没鸡肝，并放入 100g 切段的大葱、70g 切片的姜和 30ml 料酒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开大火，待水沸腾调至中火并撇去浮沫后等待5-10分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火，捞出过凉水并清洗干净",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "清洗干净后切片，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开中火。锅内加入 30ml 食用油，等待 10 秒使油升温",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入 50g 切片的大葱和 50g 切丁的姜，翻炒爆香",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "爆香后加入切片的鸡肝，翻炒至微微发黄",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入蒜苗，翻炒 30 秒，断生后调至为小火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入调味料：食用盐 5g、鸡精（味精） 5g、五香粉（十三香） 5g、胡椒粉 5g、烧烤料或 10g （可选）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "调至为大火，快速翻炒 30 秒防止糊锅，关火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "盛出盘内，可以撒入 5g 芝麻作为装饰，如果不喜欢或者没有则可以不用添加。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "焯水时，需要注意观察沸腾的水位线，不要让水溢出避免发生危险。",
    "焯完水的鸡肝建议用凉水冲洗，更推荐冰水，可以让口感更好。",
    "蒜苗指的是：大蒜幼苗发育到一定时期的青苗。有些地方叫做青蒜，特别说明一下。"
  ],
  "description": "一道稍微麻烦的菜。\n适合喜欢吃肝的人，也可以用其他的动物的肝，但是鸡肝会更好吃。\n需要初学者具有一定的焯水技巧。"
}