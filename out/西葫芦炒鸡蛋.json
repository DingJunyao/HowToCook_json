  "steps": [
    {
      "content": "西红柿洗净，切成小块，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "西葫芦洗净，切成边长约为 4cm 的菱形，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "打三个鸡蛋到碗里，打散搅匀，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅，锅内放入 5ml - 10ml 食用油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入鸡蛋，保持翻炒至鸡蛋成固体，用锅铲分成小块后盛到碗里，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅内放入 5ml - 10ml 食用油，倒入西红柿，炒至变软",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入西葫芦一起翻炒均匀，放入 6g 食用盐，将火调小然后等待 4 - 5 分钟",
      "duration_minutes": 5.0,
      "tips": ""
    },
    {
      "content": "倒入备用的鸡蛋，中火翻炒 15 秒",
      "duration_minutes": 0.25,
      "tips": ""
    },
    {
      "content": "关火，盛盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
