  "steps": [
    {
      "content": "将柠檬对半切（刀方向垂直于柠檬的头尾连线），并从其中的一半中切取一片柠檬备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "再次将柠檬对半切，将得到的 4 角柠檬用压汁器压出柠檬汁置于容器中备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "选择一个杯子，建议使用容量在 350~400 毫升的透明玻璃杯",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将 100 克冰块放置在杯底",
      "duration_minutes": null,
      "tips": "有雪克瓶的话：将冰块、金酒、柠檬汁、蔗糖糖浆倒入雪克瓶，雪克均匀"
    },
    {
      "content": "倒入 30~40 毫升金酒",
      "duration_minutes": null,
      "tips": "有雪克瓶的话：跳过"
    },
    {
      "content": "倒入 20 毫升柠檬汁（如果喜酸可以加多点或全加）",
      "duration_minutes": null,
      "tips": "有雪克瓶的话：跳过"
    },
    {
      "content": "倒入 30~40 克蔗糖糖浆",
      "duration_minutes": null,
      "tips": "有雪克瓶的话：跳过"
    },
    {
      "content": "用勺子搅拌均匀",
      "duration_minutes": null,
      "tips": "有雪克瓶的话：将充分雪克的产物倒到杯子中（如果里面的冰太碎了，可以选择过滤其中的冰，重新往杯中补充冰块）"
    },
    {
      "content": "将之前准备的一片柠檬放置好",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "缓慢沿杯壁注入苏打气泡水直至满杯",
      "duration_minutes": null,
      "tips": "不要倒在冰上，避免起泡流失"
    },
    {
      "content": "用勺子轻轻上下提拉将液体搅拌均匀",
      "duration_minutes": null,
      "tips": "不要旋转搅拌，避免起泡流失"
    },
    {
      "content": "在液面放置好装饰用的绿叶",
      "duration_minutes": null,
      "tips": "可选"
    }
  ],
  "tips": [
    "饮酒有害健康，未成年人禁止饮酒"
  ],
  "description": ""
