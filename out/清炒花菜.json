  "steps": [
    {
      "content": "将 花菜 洗净，用刀或手掰成小朵，粗茎部分可以切片，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将 大蒜 去皮，切成蒜片，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入 1000 ml 饮用水，大火烧开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入 花菜 朵，煮 2-3 分钟，至花菜颜色变浅，口感稍微软化。",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "将 煮好的 花菜 捞出，沥干水分，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅，加入 15 ml 食用油，大火烧热。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入 蒜片，快速煸炒出香味。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入 焯好水的 花菜 朵，转中大火，快速翻炒约 2 分钟，使花菜均匀受热。",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "加入 3 g 盐，继续翻炒均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "沿锅边淋入 50 ml 饮用水，盖上锅盖，焖 1 分钟，帮助花菜完全熟透入味。",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "开盖，快速翻炒均匀，即可出锅。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "提前将花菜焯水可以缩短炒制时间，并使花菜更容易熟透。",
    "炒制时间可以根据个人喜欢的花菜软硬程度调整。喜欢脆一些可以缩短时间。"
  ],
  "description": "清炒花菜是一道常见的家常素菜。富含维生素 C 和膳食纤维，口感脆嫩。做法简单，是一道快速上手的炒菜。一般初学者只需要 15 分钟即可完成。"
