  "steps": [
    {
      "content": "蒜苔切成 5cm 小段，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "五花肉切成 5mm * 5cm 丝状，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "蒜瓣拍碎切成末，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅，锅内放入 10ml 食用油。等待 10 秒让油温升高",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入蒜末，中火翻炒 10 秒 将蒜末炒出香味",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入五花肉和 5ml 生抽，中火翻炒 30 秒 将肉炒熟并上色",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将蒜苔放入锅内并加入 10ml 生抽，翻炒 30 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅内加入 20g 水，中火翻炒 5 分钟 将蒜苔炒至稍稍变软",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "最后加入 2g 食盐，中火翻炒 30 秒，即可出锅装盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "加入食盐前可尝一下咸淡，自行决定是否增减盐量",
    "选用五花肉薄片是因为切肉简单且不用腌制即可入味"
  ],
  "description": "蒜苔炒肉末是一道简单易做的菜。这是一道北方家常菜，以做法简单、味道上乘的特点，在广大北方人民群众中备受喜爱。"
