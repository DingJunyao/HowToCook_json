  "steps": [
    {
      "content": "在锅中盛装一定量自来水，确保水面没过约鸡蛋 3cm，水中插入温度计",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开火或打开电磁炉，逐渐调整电磁炉功率或火苗大小，使得水温保持在 70 摄氏度",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鸡蛋放入锅中。鸡蛋不可互相堆叠，应皆在底部，并留有空间可以晃动",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "保持当前温度 25 分钟",
      "duration_minutes": 25.0,
      "tips": ""
    },
    {
      "content": "准备一杯冰水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "捞出鸡蛋，并立刻放入冰水中，等待 3 分钟",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "将鸡蛋打入小碗，完成制作",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "若使用机械式温度计（无需供电）则温度计探头需没入水中至少 6cm，若使用电子温度计则无特殊要求",
    "锅可以采用稍厚的锅，方便控制温度",
    "虽然 70 摄氏度 25 分钟已经完全可以杀死沙门氏菌，但还是要尽量少吃，或购买正规可生食鸡蛋制作"
  ],
  "description": "一种传统的日式小吃，可以用于各种佐餐，注意与溏心蛋区分，溏心蛋是蛋黄不熟蛋白熟了，温泉蛋是蛋白不熟蛋黄熟了"
