  "steps": [
    {
      "content": "葱切花，蒜切沫，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "生抽、老抽、耗油、盐混合调料汁，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小米椒切圈，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "豆角去筋，45° 斜切4-10cm小段，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油(10ml - 15ml)，冒烟后放入葱、小米椒，翻炒至闻到香味；",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入豆角，翻炒30s,",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "加入料汁，开大火翻炒2分钟",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "倒入 150ml 水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "转中小火，盖上锅盖焖制 8-10 分钟",
      "duration_minutes": 10.0,
      "tips": ""
    },
    {
      "content": "加入蒜切沫，出锅。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "切豆角需要一定的刀工，不会的可以使用剪刀"
  ],
  "description": "巨下饭的家常菜"
}