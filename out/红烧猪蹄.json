  "steps": [
    {
      "content": "冷水锅中放入热心摊主剁好的猪蹄，加入 20 ml 料酒与葱姜，煮 15 分钟去掉血腥",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅冷油，倒入 30ml 食用油，放入 7-8 粒冰糖，开小火，熬成糖色，期间用锅铲把冰糖压碎，大概熬 2 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "熬成糖色后，放入焯过水的猪蹄，继续小火，翻炒猪蹄，直至所有猪蹄两面微黄",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入香叶 2 片、桂皮 1 块、八角 4 个、生抽 20 ml、老抽 20 ml、料酒 10 ml、姜 3 片、盐 8 克，转中火、继续翻炒 1 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入开水或者冷水，水需要没过猪蹄，盖上锅盖，大火烧开，烧开之后关火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "把锅内的食材全部倒入高压锅中，高压锅中需要 15 分钟",
      "duration_minutes": null,
      "tips": "如果同学没有高压锅，可放在锅中大火转小火熬制即可"
    },
    {
      "content": "15 分钟之后，把高压锅的食材倒入炒锅中，开大火收汁，此时可用筷子尝下味道、淡的话可以加 2~3g 盐",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火收汁时长根据锅中的水来算，一般 30 秒即可，多留点也无碍、红烧猪蹄汤也是很下饭的",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "红烧猪蹄营养丰富，味道香，汤汁浓郁、下饭强。"
}