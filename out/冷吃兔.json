  "steps": [
    {
      "content": "蒜、姜扒皮并剁碎备用，八角、桂皮、香叶、山奈、白蔻、小茴香洗净备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "干辣椒剪成 2 厘米的小段，洗净备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小葱/大葱/洋葱洗净，洋葱切成小块。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "兔肉剁成 2 厘米的小块，加入盐、料酒、味精调味，腌制 15 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中倒油，油温 4 成热下小葱/大葱/洋葱，中小火煸炒出香味，待到小葱/大葱/洋葱微焦，将其捞出。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开大火升高油温，油温 8 成热时下入兔肉，炸制过程转中小火，炸至兔肉微微焦黄时捞出兔肉。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "升高油温，倒入干辣椒、青花椒、八角、桂皮、香叶、山奈、白蔻、小茴香；转小火将辣椒段炸脆。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "重新倒入兔肉，加入蚝油、翻炒几分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火，加入蒜、姜、白芝麻，翻炒均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放置一夜更加入味。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "食材的量为 1 斤兔肉的情况下的量，按照兔肉的量等比例放缩",
    "在操作的第 6 步骤中要注意：油量应该淹没兔肉，若未淹没需要及时补充。",
    "在操作的第 7 步骤中要注意：辣椒极容易炸糊，炸糊会变成黑色，这个过程非常快，所以一定要小火，基本等到没太多水气蒸发时，就可以下兔肉了。"
  ],
