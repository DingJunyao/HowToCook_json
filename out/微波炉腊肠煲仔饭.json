  "steps": [
    {
      "content": "将米淘洗干净后倒入 饭碗 内，加入 400ml 的水，盖上盖",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入微波炉，高火，6 分钟，煮饭途中准备原料",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "切好腊肠",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "洗好青菜",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "切好红萝卜片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "切好葱花",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "青菜碗 中放入青菜、红萝卜片，倒入 10 ml 油，放入 5 g 盐",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小碗 中倒入 10 ml 生抽、5 ml 油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "6 分钟后，用毛巾或隔热手套取出碗，可以看见米饭已经八分熟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在米饭上摆入切片的腊肠，继续高火 2 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出腊肠饭，放入 青菜碗，高火 4-5 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在腊肠饭上摆好青菜，磕入鸡蛋，看个人喜好继续高火 40-60 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出腊肠饭，此时已经基本完成。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将 小碗 放入，继续高火 30 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在腊肠饭上淋上叮热的生抽，撒上葱花即可",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "多余的青菜可以沾着酱油吃",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "程序员以单身汉居多 ，做再多的菜也会有一个人吃不完的烦恼，因此一份简单的腊肠煲仔饭则刚刚好。\n使用微波炉烹制仅需 15 分钟 ，既营养又美味，这是一道简单且细腻的主食，给 TA 露上一手吧。"
