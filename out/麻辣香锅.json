  "steps": [
    {
      "content": "烧开一锅水（水量能没过第 2-4 步中的食材即可）。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在开水中放入青菜，焯 5 分钟后盛出备用。",
      "duration_minutes": 5.0,
      "tips": ""
    },
    {
      "content": "在开水中放入无骨肉，焯 4 分钟后盛出备用。",
      "duration_minutes": 4.0,
      "tips": ""
    },
    {
      "content": "在开水中放入北京麻辣方便面，煮 2 分钟后盛出备用。",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "倒出开水，擦干锅具，放入 105 克食用油，大火加热 30 秒。",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "放入麻辣香锅调料，翻炒 20 秒。",
      "duration_minutes": 0.33,
      "tips": ""
    },
    {
      "content": "放入干辣椒，翻炒 10 秒。",
      "duration_minutes": 0.17,
      "tips": ""
    },
    {
      "content": "放入焯过的青菜，改中火，翻炒 3 分钟。",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "放入焯过的无骨肉，翻炒 3 分钟。",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "放入煮过的北京麻辣方便面，用筷子翻动 1 分钟。",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "关火，出锅。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "青菜、无骨肉、干豆腐、北京麻辣方便面的配比为推荐配比，如果有自己喜欢的食材，可以按喜好重新分配比例。",
    "大火通常温度在 240 摄氏度，以电磁炉为例，输入功率大约 2 千瓦。",
    "中火通常温度在 120 摄氏度，以电磁炉为例，输入功率大约 1.4 千瓦。"
  ],
