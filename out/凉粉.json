  "steps": [
    {
      "content": "准备食材。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "把豌豆淀粉和水各 100 克混合搅拌。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "往锅中倒入 600g 水，大火煮开后转为小火。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入淀粉水，边倒边不断的搅拌，搅拌到浓稠且色泽均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "找一个容器，在容器中刷一层薄薄的食用油。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将煮好的淀粉倒入容器中冷藏 2-4 小时。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "冷藏后取出，脱模，切条。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大蒜和小米辣剁成沫，放上 10g 辣椒粉，5g 花生碎，热油搅拌均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "再加入 10ml 酱油，10ml 醋，5g 白糖，3g 鸡精，3g 盐搅拌均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将调味料倒在凉粉上，然后撒上香菜即可。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
