  "steps": [
    {
      "content": "血肠用牙签多扎一些小孔，然后放水中小火煮十分钟，不要让水烧开，保持 80 度，否则血肠非常容易爆开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "煮好的血肠切块备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "排骨放料酒焯水，控干水分备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅内放入菜籽油，放蒜瓣，干辣椒，姜粉炒香。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入排骨翻炒至表面金黄。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "酸菜洗净拧干水分，放入锅中，加入香油翻炒，大火翻炒二分钟。",
      "duration_minutes": null,
      "tips": "香油可以更好的去除酸味而且让酸菜更香"
    },
    {
      "content": "加入 600 毫升热水。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "转入电压力锅，加香叶，八角，葱结，盐。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "浓香模式压 40 分钟。",
      "duration_minutes": 40.0,
      "tips": ""
    },
    {
      "content": "到时间后放气开盖。加入血肠和枸杞，盖上锅盖焖二分钟即可。",
      "duration_minutes": 2.0,
      "tips": "血肠是熟的，不需再加热"
    },
    {
      "content": "倒入盆中，按照上表调制蘸料，即可开吃。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "杀猪菜的做法 （荤菜）"
