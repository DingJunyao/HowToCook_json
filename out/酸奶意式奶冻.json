  "steps": [
    {
      "content": "吉利丁片剪成小片，泡入冷水中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "淡奶油和糖放入锅中，加热至 60 度",
      "duration_minutes": null,
