  "steps": [
    {
      "content": "大葱、小米辣切小段，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "莲藕去皮，切成不超过 3cm 的小块，放入水中备用",
      "duration_minutes": null,
      "tips": "防止氧化发黑"
    },
    {
      "content": "取炒锅，锅内放入 500ml 凉水，煮沸",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将藕丁下入沸水中，焯水 2 分钟后，取出放入盘中备用",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "将锅中水倒掉后，将锅加热干燥，加入 10-15 ml 食用油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "待油温升高后，下入葱花，小米辣爆香",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将处理好的藕丁下入锅中，大火翻炒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入生抽、老抽、耗油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻炒 2 分钟即可出锅",
      "duration_minutes": 2.0,
      "tips": ""
    }
  ],
  "tips": [
    "食用莲藕要挑选外皮呈黄褐色、肉肥厚而白的。如果发黑，有异味，则不宜食用。",
    "请尽量不要使用铁器，会导致莲藕发黑"
  ],
  "description": "小炒藕丁是一道简单易做的菜，莲藕营养丰富，非常适合素食。预计制作时长 20 分钟"
