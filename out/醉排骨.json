  "steps": [
    {
      "content": "排骨中加入 5 g 地瓜粉和水进行搅拌，清洗 2-3 遍后放入大碗备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "排骨中加入鱼露、地瓜粉、鸡蛋黄 充分搅拌",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将排骨一个一个放入锅中（切记不可以整碗倒入），保证每个不要粘在一起",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "全部放入后，每 30 S 用勺子来回两面翻转瘦肉块，直至排骨表面金黄",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出排骨，一分钟后倒入油锅中继续炸，直至瘦肉块表面出现焦黄后，取出放入大碗备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "准备一个小碗，加入蒜末、香醋、白砂糖、鱼露、番茄酱、葱花、芝麻搅拌均匀，倒入 5 ml 热油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将汤汁浇灌入排骨，在充分搅拌后倒入盘中",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "本次制作过程中，由于疫情原因没有鱼露，只能用老抽代替，所以排骨颜色偏黑，正常是金黄色"
  ],
  "description": "醉排骨是福建省福州市特色传统名菜"
