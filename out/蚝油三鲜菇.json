  "steps": [
    {
      "content": "蟹味菇、白玉菇 去掉根部泥土，掰散菌朵",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "香菇切片（每片厚度 0.5-1 cm，厚点相对薄点更有嚼劲）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "生粉倒入小碗中，加入 50ml 水，搅拌生粉直至融化没有颗粒（即水淀粉）备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "水开，放入西蓝花，清水煮 3 分钟，放入碗中备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "洗锅烧开水，加入 5 g 食用盐，倒入蟹味菇、白玉菇、香菇，水煮 1 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "1 分钟后，捞出沥干水分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，待油开始冒小泡，放入姜末、小米辣、菜椒 煸炒 30 S",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入三鲜菇，然后依次倒入生抽、蚝油、鸡精，翻炒均匀后，倒入水淀粉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "中火烧干汁，加入料酒、葱花 出锅",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "摆上西蓝花",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "几分钟就能做出的蚝油蘑菇，滑嫩入味鲜美可口，别提多好吃了。"
}