  "steps": [
    {
      "content": "牛里脊切成不超过 3cm 宽，3mm 厚的薄片，倒入 6ml 酱油，用手抓匀备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "芹菜切成不超过 5cm 的小段，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小米椒切成丝状，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "野山椒切成颗粒，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "香菜切成成不超过 3cm 的小段，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅，锅内放入 15ml 食用油，大火等待 30 秒让油温升高",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入小米椒和野山椒爆香",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入牛里脊和芹菜，然后大火翻炒 1 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火，撒上香菜，盛盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "操作时，全程需要开大火"
  ],
  "description": "小炒黄牛肉是一道简单易做的湘菜。口味十分劲爆爽口。一般初学者只需要 1 小时即可完成"
}