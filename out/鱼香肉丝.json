  "steps": [
    {
      "content": "制作腌料：将下列原料混合：生抽 5ml、料酒 5ml、淀粉 5g、水 20ml、蛋清 1 个",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "制作香汁：将下列原料混合：生抽 5ml、醋 15ml、白糖 10 克、盐 1 克、淀粉 5g、水 20ml",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用腌料腌制里脊肉 15-30 分钟。注意将肉抓匀。",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "干木耳泡 4 个小时，洗净，切成小块。",
      "duration_minutes": 240.0,
      "tips": ""
    },
    {
      "content": "青椒洗净，去蒂，切成丝。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "胡萝卜洗净，切成丝，将胡萝卜丝焯水。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "姜、蒜切沫。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "葱切成 5mm 的小段。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将锅烧热，加入 15ml 油。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "向锅内倒入准备好的腌肉，快速滑散至变白，盛出备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将锅烧热，加入 5ml 油。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入全部葱、姜、蒜、豆瓣酱。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入全部胡萝卜，翻炒 20s 后，放入青椒和木耳，翻炒 2 分钟。",
      "duration_minutes": 2.33,
      "tips": ""
    },
    {
      "content": "倒入炒过的肉。快速翻炒均匀。注意不要炒超过 20 秒。",
      "duration_minutes": 0.33,
      "tips": ""
    },
    {
      "content": "倒入香汁。快速翻炒均匀。注意不要炒超过 15 秒。",
      "duration_minutes": 0.25,
      "tips": ""
    },
    {
      "content": "关火，盛盘。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
