  "steps": [
    {
      "content": "把螃蟹刷洗干净，然后在砧板上对半劈开",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅里下菜油，放入姜末和豆瓣酱爆香，加入冰糖炒化，直到冒小气泡就盛出",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在盘子里铺上一层酱，然后把切好的螃蟹切开面朝下，整齐排放在酱上",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放点葱段和姜片，建议敲个鸡蛋或在盘底铺肉末",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "上锅蒸 10-12 分钟",
      "duration_minutes": 12.0,
      "tips": ""
    }
  ],
  "tips": [
    "咸口放 50 g 豆瓣酱，甜口减少豆瓣酱的用量并加入冰糖和番茄酱",
    "出锅后再撒上一点葱花会更香也更好看",
    "参考资料：[秋风起，平湖这道美味很下饭_潮新闻官网](https://tidenews.com.cn/news.html?id=2925971)"
  ],
  "description": "酱炖蟹，秋日限定咸鲜风味！蟹黄绵润裹着酱香，蟹肉清甜入味，汤汁浓郁拌饭一绝。"
