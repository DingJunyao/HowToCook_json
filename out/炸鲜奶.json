  "steps": [
    {
      "content": "将牛奶倒入碗中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入玉米淀粉和白糖，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将模具刷上食用油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "牛奶下锅，中火烧开",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "烧开后转小火，边煮边搅拌",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "牛奶变粘稠后出锅，倒入模具",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将模具放冰箱冷却 1 小时",
      "duration_minutes": 60.0,
      "tips": ""
    },
    {
      "content": "拿出，切成大小均匀的条，随后放入碗中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "向碗中倒入一半的面包糠，奶糊裹上后取出，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在一个新碗中打入鸡蛋，搅匀，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将奶糊裹上蛋液和剩余的面包糠",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中倒入足以覆盖奶糊的油，下锅",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "奶糊外观呈金黄状态后停火，摆盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "一份约 12 个",
    "煮牛奶时必须小火慢煮，才能均匀受热",
    "奶糊下锅时油温不能过高或过低，最好保持在 5 分热",
    "参考资料：王刚的教学视频(https://www.bilibili.com/video/BV1U7411E7LH/)"
  ],
  "description": "炸鲜奶是一种外脆里嫩的甜点，营养价值适中，制作难度中等，预计制作时长约为 20 分钟。"
