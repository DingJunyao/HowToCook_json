  "steps": [
    {
      "content": "猪五花肉切大块",
      "duration_minutes": null,
      "tips": "约 4.5cm ，冷冻半小时至一小时更好切"
    },
    {
      "content": "豆皮切 2cm 的宽度",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "生姜切片",
      "duration_minutes": null,
      "tips": "每片厚度约 3mm"
    },
    {
      "content": "水烧开",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鹌鹑蛋煮熟并用叉子/牙签扎孔",
      "duration_minutes": null,
      "tips": "尽量多些好入味"
    },
    {
      "content": "大葱取葱白",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "冷水锅中放入切好的猪五花肉，加入料酒与葱姜，煮 15 分钟去掉血腥",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中放入两片生姜提味",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开中小火后直接加入五花肉，不需要放入食用油，每块五花肉六个面都煎一下，煎至出油即可",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将煎出的油倒出备用，并将五花肉推至一边，加入 15g 冰糖，翻炒至冰糖融化；",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "融化后将五花肉与冰糖炒至融合上色，加入生抽 10ml、老抽 15ml、料酒 5ml",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻炒至上色；",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入烧好的开水炖煮 40 分钟，并放入生姜 2 片、香叶 3 片、八角 2 个",
      "duration_minutes": null,
      "tips": "刀工差的同学切的过大请自觉延长炖煮时间"
    },
    {
      "content": "盖上锅盖煮至沸腾后，加入煮好扎好孔的鹌鹑蛋和豆皮，开中小火，等待 40 分钟。",
      "duration_minutes": null,
      "tips": "中途可适当翻搅防止粘锅"
    },
    {
      "content": "打开锅盖，待汤汁快没有的时候开大火收汁",
      "duration_minutes": null,
      "tips": "切记不可收干"
    },
    {
      "content": "加入 2-3g 盐，翻炒一下，就可以出锅了。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "如果有可能，请尽量把刀磨的锋利一些。"
  ],
  "description": "这份红烧肉教程是一道新手不败的菜谱。配着米饭好吃的停不下来，香糯无敌棒色泽诱人肥而不腻。建议搭配米饭食用。"
}