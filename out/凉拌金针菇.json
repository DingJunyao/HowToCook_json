  "steps": [
    {
      "content": "将 金针菇 根部切除，用清水冲洗干净，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将 小葱 洗净，切成葱花，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将 大蒜 去皮，切成蒜末，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入 1000 ml 饮用水，大火烧开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入 金针菇，煮 1-2 分钟，至金针菇变软。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将 煮好的 金针菇 捞出，沥干水分，放入一个较大的碗中，备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在另一个干净的小碗中，加入 15 ml 生抽，10 ml 醋，3 g 白糖（可选），5 ml 香油（可选）。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入切好的 大蒜末。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "搅拌均匀，使 白糖 充分溶解，酱汁混合均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将制作好的酱汁均匀淋在 金针菇 上。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "撒上切好的 小葱花。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "根据个人喜好，淋上 5 ml 辣椒油（可选）。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用 筷子 轻轻拌匀，即可食用。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "金针菇焯水时间不宜过长，以免影响口感。",
    "酱汁的比例可以根据个人口味喜好进行调整。",
    "如果不喜欢吃辣，可以省略辣椒油。"
  ],
  "description": "凉拌金针菇是一道简单快捷的开胃凉菜。口感脆嫩爽滑，富含膳食纤维和多种维生素。制作过程无需复杂的烹饪技巧，非常适合新手和忙碌时快速准备。一般初学者只需要 10 分钟即可完成。"
}