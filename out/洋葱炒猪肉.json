  "steps": [
    {
      "content": "洋葱切片，猪肉，蒜头拍碎，以及混合上述调味料备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "炒锅内倒入 1 大匙食用油（等待 10 秒让油温升高），倒入猪肉",
      "duration_minutes": 0.17,
      "tips": ""
    },
    {
      "content": "炒至变色后下蒜头炒香盛起备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "原锅下洋葱翻炒 3~4 分钟后加入调味料炒匀",
      "duration_minutes": 4.0,
      "tips": ""
    },
    {
      "content": "下刚盛起备用的猪肉翻炒至猪肉熟后",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "待猪肉熟后再翻炒 1、2 分钟即可起锅",
      "duration_minutes": 2.0,
      "tips": ""
    }
  ],
  "tips": [
    "可以考虑购买茶匙，大匙来精准确定用料的量。",
    "猪肉可选猪肩肉片或是切好的肉丝看个人喜好",
    "参考资料：爱料理(https://icook.tw/)"
  ],
  "description": "咸中带甜，简单上手，一不小心可能让人多吃一碗饭。一般只需 15 分钟即可完成。"
