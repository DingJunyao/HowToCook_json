  "steps": [
    {
      "content": "冬瓜去皮，切 边长不超过 2cm 小块",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，放入冬瓜，缓缓翻滚煎炸 2 分钟 ，直至冬瓜表面泛金黄色",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "取出冬瓜，放入大碗备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "利用锅中的剩余油，依次放入姜末、生抽、蚝油，翻炒 15 S",
      "duration_minutes": 0.25,
      "tips": ""
    },
    {
      "content": "重新倒入冬瓜，翻炒 30 S 后，加入开水，水要没过冬瓜表面，大火煮 10 分钟",
      "duration_minutes": 10.5,
      "tips": ""
    },
    {
      "content": "加入老抽上色，继续煮，直至冬瓜软糯（筷子可以轻松插近冬瓜）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入鸡精、料酒、香葱翻炒后 30 S， 取出冬瓜到大碗中",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "锅中剩余汤汁保留，倒入水淀粉，煮开后汤汁浇灌在冬瓜表面",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "红烧冬瓜是一道具有色泽红亮，香鲜味美、营养价值丰富的家常菜"
}