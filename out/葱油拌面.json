  "steps": [
    {
      "content": "将 小葱 洗净，切成长段（约 5-7 cm）。葱白和葱绿可以分开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入 100 ml 食用油，中火烧热。先放入葱白段，煸炒至微黄。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入葱绿段，转小火，继续煸炒。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "保持小火，耐心煸炒约 15-20 分钟，直至葱段变得焦黄酥脆。",
      "duration_minutes": 20.0,
      "tips": ""
    },
    {
      "content": "将焦黄的葱段捞出。",
      "duration_minutes": null,
      "tips": "葱油保留在锅中"
    },
    {
      "content": "在锅中的葱油中，加入 60 ml 生抽，20 ml 老抽，15 g 白糖。小火加热并搅拌，约 1 分钟，至糖溶解，酱汁混合均匀。立即关火。将制作好的葱油酱汁倒入容器中，放凉后密封保存。",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "取 80 g 干面条。",
      "duration_minutes": null,
      "tips": "煮面条，按份操作"
    },
    {
      "content": "锅中加入 1000 ml 饮用水，大火烧开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入 面条，根据面条包装说明，煮至熟透（通常 3-8 分钟，以包装说明为准）。",
      "duration_minutes": 8.0,
      "tips": ""
    },
    {
      "content": "将 煮好的 面条 捞出，沥干水分，放入碗中。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在装有 面条 的碗中，加入 15 ml 之前做好的 葱油酱汁。",
      "duration_minutes": null,
      "tips": "混合拌面 ，按份操作"
    },
    {
      "content": "可以加入之前炸好的葱段。",
      "duration_minutes": null,
      "tips": "可选"
    },
    {
      "content": "用 筷子 快速搅拌均匀，即可食用。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "炸葱油时，火一定要小，要有耐心，才能将葱的香味充分炸出。",
    "制作好的葱油酱汁可以冷藏保存一段时间，下次吃面时直接取用。"
  ],
  "description": "葱油拌面是一道经典的上海家常面点。做法简单，以其独特的葱油香味而闻名。富含碳水化合物和脂肪，能够快速补充能量。一般初学者只需要 20 分钟即可完成。是一道非常适合加班后的简单晚餐选择。"
}