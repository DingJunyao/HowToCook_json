  "steps": [
    {
      "content": "将 Mo ml 的油与洗净的米混合，尽量确保完全混合，即每粒米上至少都沾上少量油",
      "duration_minutes": null,
      "tips": "可选；Mo：生米体积 / 10，本例为 6~11 mL"
    },
    {
      "content": "将 米-油混合物品冷藏保存，冷藏时间 Tc。",
      "duration_minutes": null,
      "tips": "可选；Tc = 生米体积 /10 ml/分钟，本例为 6~11 min"
    },
    {
      "content": "将米和水加入锅中。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开大火，加热到 T1。",
      "duration_minutes": null,
      "tips": "T1 = 1.5 分钟/500ml * 水体积，本例为 1.62 ~ 3.96 min"
    },
    {
      "content": "在 T1 之前将火关小。如果忘记此步骤，水可能会漫出而熄灭火焰。非常危险！",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加热到 Tr。在 Tr 时关闭火源。",
      "duration_minutes": null,
      "tips": "Tr = 10 分钟/500ml * 水体积，本例为 10.8 ~ 26.4 min"
    }
  ],
  "tips": [],
  "description": "大米粥是一道以大米和水作為主要原料經大火煮沸熬製而成的美食，老少皆宜，米粥具有補脾、和胃、清肺功效。"
