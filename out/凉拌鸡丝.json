  "steps": [
    {
      "content": "姜切片，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中倒入 4 升水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入鸡胸肉、姜片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入 20 毫升料酒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开大火不盖盖将水烧开",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "水开后转中火，用勺子将浮沫捞出",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "继续煮 5-7 分钟，如果是非冷冻肉煮 5 分钟，冷冻肉煮 7 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸡胸肉大小会影响成熟时间，用筷子插入鸡胸肉，如果能轻松插入，代表鸡肉熟了。如果不熟需延长煮制时间",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用凉白开水冲泡鸡胸肉，使鸡胸肉降至室温",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "顺着鸡胸肉纹理将鸡胸肉撕成细丝",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "准备一个碗",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "碗中加入准备好的花椒油、生抽、香醋、白糖、盐",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "搅拌料汁，使糖和盐尽量溶化",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将料汁倒入鸡丝中，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "这道菜是隔离期间用现有材料做的，有条件可以加入香菜、小葱等进行调味",
    "喜欢吃辣的可以加入辣椒油"
  ],
  "description": "隔离期间的一道快手菜，少油低卡，制作简单，预计制作时间 30 分钟"
}