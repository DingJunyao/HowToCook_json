  "steps": [
    {
      "content": "将锅烧热后，加入 25 ml 油，放两个鸡蛋，煎至底部完全凝固",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻面，煎至两面完全凝固",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火，将鸡蛋取出，剪成 2-5 cm² 的小块后放回锅中（也可以直接用锅铲铲碎）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "重新开火，倒入可乐、生抽、老抽、豆瓣酱、蚝油，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加热到锅内液体剩 1/3，倒入米饭和火腿肠翻炒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻炒均匀后，改小火，锅内食物中心挖一个洞，打入 1 个鸡蛋，盖上锅盖，焖 2 分钟",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "开盖翻炒至第三颗鸡蛋熟透，撒上葱花和胡椒粉，出锅",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "含糖可乐口感更好",
    "如果喜欢干一点，多炒一会儿",
    "如果嫌麻烦，可以在第一步直接放 3 个鸡蛋，取消挖洞打另一个鸡蛋的步骤"
  ],
  "description": "可乐炒饭用可乐代替糖分带来焦香微甜的风味。懒人福音，只需简单几步就能做出独特口感的炒饭，香滑鸡蛋配上浓郁酱汁，每一口都是惊喜。"
