  "steps": [
    {
      "content": "五花肉切块，每块 2-3 cm 大小",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入 150 ml 食用油，倒入五花肉，煎炸 2 分钟 后，加入盐，翻炒五花肉，2 分钟 后出锅",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅中加入 50 ml 食用油，倒入白砂糖，翻炒到咖啡色",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入五花肉，翻炒 30 S ，加入姜片、蒜头后翻炒 30 S",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入料酒，五香粉、葱，加入水没过五花肉，盖上锅盖煮 10 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入生抽、老抽、蚝油，中火煮 20 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "开锅，大火烧汁，端盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "葱是整根，不需要切碎",
    "步骤二加盐的目的是锁住五花肉的油脂",
    "制作过程，用部分五花肉做了水煮处理，跟未处理的一起做后续制作，发现未水煮的肉质更 Q 弹"
  ],
  "description": "徽式红烧肉是一道由五花肉等食材制成的菜肴。"
}