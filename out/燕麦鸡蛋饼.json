  "steps": [
    {
      "content": "将牛奶与干燕麦混合搅拌均匀至黏稠状。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鸡蛋搅拌均匀至颜色单一程度。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鸡蛋液倒入燕麦牛奶中继续搅拌至黏稠、均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "平底锅中加入一层黄油并覆盖均匀。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "下入搅拌好的食材，并摊开至饼状。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小火加热两到三分钟。如想要加入蔬菜，可以在加热过程中加入碎菜叶。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻面继续加热两分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "出锅，搭配剩下的牛奶作为早餐。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "如果口味偏咸口，可以在搅拌鸡蛋液时加入盐，胡椒等调料。",
    "煎饼时使用小火，避免燕麦部分煎糊。"
  ],
  "description": "燕麦鸡蛋饼是极具营养、便于制作、适宜快速制作的早餐。尤其适宜热爱健身的上班族。"
