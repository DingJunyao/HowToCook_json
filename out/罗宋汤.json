  "steps": [
    {
      "content": "洋葱、胡萝卜、欧芹切 1cm 见方小丁",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "红肠、马铃薯切 2cm 块",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "包菜去梗后，手撕至 2cm 片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "牛肉撒盐 3 g 、黑胡椒 3 g 腌制 5 分钟",
      "duration_minutes": 5.0,
      "tips": ""
    },
    {
      "content": "平底锅烧热，加入植物油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "煎制牛肉，直至表面焦黄色（可以带生，千万别糊了），取出备用。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "汤锅烧热，加入橄榄油、洋葱丁、胡萝卜丁、欧芹丁",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "炒至洋葱透明，加入番茄膏、番茄罐头",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入牛肉、马铃薯丁，翻炒均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加水没过食材，中火烹制 1 小时",
      "duration_minutes": 60.0,
      "tips": ""
    },
    {
      "content": "开锅加入包菜丁、红肠丁，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "中火烹制半小时",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "开盖加入剩余 15 g 盐，混合均匀后盛盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "番茄尽量不用新鲜番茄代替，番茄罐头+番茄膏的组合风味更足",
    "除了胡萝卜、洋葱、欧芹、牛肉是必备食材外，其余可自由搭配"
  ],
  "description": "罗宋汤是一道源自俄罗斯甜菜汤的汤品，在传入上海后有了本土化的做法。其制作较为简单，初学者只需要 2-3 小时即可完成。"
}