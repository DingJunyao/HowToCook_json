  "steps": [
    {
      "content": "将梅头猪肉（100 克）洗净，然后用厨房纸抹干水份，将猪肉切成比想要的成品小一圈的大小。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用盐（1/2 茶匙，2.5 mL）腌制梅头猪肉 20 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将青椒（25 克）切碎。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将菠萝片（75 克）切件。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在碗中加入茄汁（4 汤匙，60 mL）﹑白醋（2 茶匙，10 mL）﹑蒜蓉（1 汤匙，15 mL）﹑生抽（½ 茶匙，2.5 mL）﹑生粉（2½ 茶匙, 12.5 mL）﹑白砂糖（2 汤匙，30 mL）﹑盐（¼ 茶匙，1.25 mL）和水（200 毫升），拌匀成酱汁。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将梅头猪肉粒沾上生粉（6 汤匙, 90 mL）。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入油（500 毫升）中火加热。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将梅头猪肉粒放至锅里中火炸 5 分钟，然后盛起。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入梅头猪肉粒，再大火翻炸 1 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入油（1 茶匙，5 mL）和酱汁，中火加热 3 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入青椒和菠萝，大火加热 2 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将已炸好的梅头猪肉粒与酱汁拌匀即可。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "想让肉更有层次可以在生粉中加鸡蛋，炸出来会更香脆"
  ],
  "description": "咕噜肉是非常下饭的菜肴，只需一道就可以吃得津津有味，大人小孩都爱吃。而这次做的是简易版菠萝咕噜肉，利用简单的材料就可以在家做出特有风味的咕噜肉 。"
}