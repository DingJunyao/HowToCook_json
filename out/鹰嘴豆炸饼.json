  "steps": [
    {
      "content": "将干鹰嘴豆用清水浸泡过夜（至少 8 小时），浸泡后体积会膨胀至约两倍",
      "duration_minutes": 480.0,
      "tips": ""
    },
    {
      "content": "将浸泡好的鹰嘴豆沥干水分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入锅中，加入 500ml 水和 1 个红茶包（用于上色）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火煮沸后转中火，煮 25-30 分钟，直至鹰嘴豆用手指可以轻松压碎",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "取出红茶包，保留煮豆的汤水，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在炒锅中倒入 30ml 食用油，中火加热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入切碎的洋葱，翻炒至金棕色（约 6-8 分钟）",
      "duration_minutes": 8.0,
      "tips": ""
    },
    {
      "content": "加入磨碎的生姜和大蒜，翻炒 1 分钟",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "加入切碎的番茄，翻炒至番茄完全软烂出油（约 5 分钟）",
      "duration_minutes": 5.0,
      "tips": ""
    },
    {
      "content": "加入姜黄粉 3g、红辣椒粉 5g、香菜粉 8g、孜然粉 5g、盐 6g",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "翻炒 2 分钟，使香料充分释放香味",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "将煮好的鹰嘴豆连同汤水一起倒入锅中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入青辣椒，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火煮沸后转小火，炖 15-20 分钟，期间可用铲子背面压碎一些鹰嘴豆使汤汁变稠",
      "duration_minutes": 20.0,
      "tips": ""
    },
    {
      "content": "加入印度综合香料粉 5g 和石榴粉 3g（或柠檬汁 15ml）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "搅拌均匀后关火，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在大碗中混合中筋面粉 250g、小苏打 2g、盐 3g",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入酸奶 60ml 和食用油 15ml",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "逐渐加入温水，边加边揉，揉成光滑柔软的面团（面团应比普通面团稍软）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用湿布盖住面团，静置 30 分钟",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "将面团分成 8 个等大的小剂子",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取一个剂子，手上沾少量油，擀成直径约 15cm、厚度约 3mm 的圆形面饼",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在深锅中倒入 500ml 食用油，中大火加热至油温约 180°C",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将面饼轻轻滑入热油中，用漏勺轻轻按压面饼使其膨胀鼓起",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "炸 1-2 分钟，翻面炸至两面金黄",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "捞出，用厨房纸吸去多余油分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鹰嘴豆咖喱重新加热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "炸饼趁热上桌，搭配鹰嘴豆咖喱食用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "可搭配切片洋葱、青辣椒和柠檬角",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "鹰嘴豆提前浸泡是必须步骤，不泡的话煮不软。如果时间紧迫，可以用高压锅将未泡的鹰嘴豆压 20 分钟。",
    "红茶包的作用是给鹰嘴豆上色，使其呈现深棕色。这是印度餐厅的秘诀。",
    "炸饼面团中的酸奶和小苏打是其松软蓬松的关键。面团不宜太硬。",
    "这道菜在印度是国民级的早午餐，从路边摊到高档餐厅都有供应。在中国的印度餐厅中通常被称为\"鹰嘴豆咖喱配炸饼\"。"
  ],
  "description": "Chole Bhature(छोले भटूरे)— 鹰嘴豆咖喱配油炸面饼\n鹰嘴豆炸饼是北印度最受欢迎的经典街头小吃和早餐之一，尤其在德里和旁遮普邦广受喜爱。\"Chole\"是用丰富香料炖煮的鹰嘴豆咖喱，\"Bhature\"是松软蓬松的油炸面饼。两者搭配食用，口感层次丰富——饼的松软与鹰嘴豆的浓郁相得益彰。约 50 分钟完成（鹰嘴豆需提前浸泡 8 小时）。"
}