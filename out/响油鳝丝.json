  "steps": [
    {
      "content": "将鳝鱼切成三段后切成细丝",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入 0.5 g 胡椒粉、3 g 料酒搅拌均匀，再加入 5 g 香油腌制",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热油滑锅",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入植物油，烧到 6 成热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入一半蒜末和全部姜末，翻炒几下",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入鳝丝，中火爆炒 30 秒",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "边缘淋入 10 g 料酒，翻炒几下",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入生抽，炒匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入蚝油、老抽，翻炒几下",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入食用盐、白糖、3 g 胡椒粉，炒匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "淀粉和水混合为水淀粉，倒入锅中，收汁至浓稠",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "装盘，撒上蒜蓉、葱花",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "另起锅烧热，加入猪油，烧至七成热，浇在鳝丝上",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "不能将鳝鱼的血洗得太干净，否则鳝鱼很容易发黑发臭",
    "鳝鱼可以让摊主帮忙宰杀",
    "可以多加一些胡椒粉和白糖，有利于去腥增香",
    "参考资料：[“响油鳝丝”的家常做法，味道很赞，先收藏了 - YouTube](https://www.youtube.com/watch?v=X2DvbhnWcN4)"
  ],
  "description": "响油鳝丝一道经典的江浙沪风味菜，鳝丝鲜嫩滑爽，以蒜香、姜末和酱汁调味，淋热猪油后香气扑鼻，口感浓郁微甜，超下饭～"
}