  "steps": [
    {
      "content": "冬瓜去皮，切成 25cm 长 3cm 厚的片",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将切好的冬瓜放入碗中，放入 15g 盐，将冬瓜抹匀，放置 10 分钟",
      "duration_minutes": 10.0,
      "tips": ""
    },
    {
      "content": "放置冬瓜的同时，换个碗放入肉末，葱姜末， 5g 盐，淀粉 5g，胡椒粉，生抽，胡椒粉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "使用筷子在肉末中进行顺时针搅拌，搅拌到食材颜色没有明显对比（约 2 分钟）",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "将腌制好的冬瓜（会变软）使用清水洗三遍",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "拿出 1 片冬瓜片卷起来，并把肉塞进去",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入碟子中摆到碟子的边缘",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "打入 1 个鸡蛋到中间圆圈处",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入普通铁锅中水烧开后，蒸 15 分钟，盖上锅盖",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "开盖，取出蒸好的冬瓜酿肉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将冬瓜酿肉碟子的水倒入锅中，放入水淀粉，加入 50ml 清水倒入锅中烧开",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "淋到冬瓜酿肉上",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "操作时，拿出冬瓜酿肉时注意碟子很烫，小心操作。",
