  "steps": [
    {
      "content": "胡萝卜去头尾，去皮，滚刀切",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "洋葱剥去外层去芯，切成月牙状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "土豆去皮、切大块",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "肉切块状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "剥蒜拍平切碎",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "咖喱块切碎，增加接触面积加速溶解",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热油锅放入蒜和肉，快速翻炒至肉表面变白",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入胡萝卜，快速翻炒至均匀受热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入洋葱，快速翻炒至洋葱变透明状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入土豆，保持翻炒至土豆变软（可以用筷子确认）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加水没过所有食材，沸腾后等待 15 分钟",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关火，加咖喱并搅拌",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "等待咖喱融化后再开火，缓慢搅拌 10 分钟，防止糊锅",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在外观呈粘稠状态关火结束制作",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "冷藏的咖喱每次取出需要吃的份量，加热后盖在米饭上。微波炉：单人份高火 2-3 分钟；锅：需额外加 50ml 水，加热时保持搅拌",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "食材用量与咖喱成正比，计算部分以 半盒好侍咖喱块(115g) 为例。半盒约六碗份，做好的咖喱在冰箱冷藏后风味更佳，不用担心一个人吃不完。",
    "步骤 6 可以在 12 的等待过程进行，在这个过程也可以用清水锅煮些蔬菜，或做个煎蛋。",
    "11 到 12 之间，需要注意观察沸腾的水位线，如发现低于 2/3 的食材应加热水至没过食材。",
    "参考资料：世界美食教程的微博视频(http://t.cn/EJ77yFy)"
  ],
  "description": ""
