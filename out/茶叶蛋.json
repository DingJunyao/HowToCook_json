  "steps": [
    {
      "content": "用冷水将鸡蛋煮熟，大火大约 8 分钟（根据自家厨具决定）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸡蛋捞出，过冷水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鸡蛋互相碰撞，使每个鸡蛋产生裂缝",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鸡蛋下锅，放入八角，香叶，桂皮，茴香，冰糖，红茶，生抽，老抽，食盐",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加水直至没过鸡蛋",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火煮开之后，转中小火煮 15 分钟",
      "duration_minutes": null,
      "tips": "中火煮15 分钟之后，捞出料渣，鸡蛋再浸泡一会口感更佳"
    }
  ],
  "tips": [
    "鸡蛋捞出过冷水是为了让鸡蛋和壳之间产生间隙",
    "食盐可根据个人口味选择不加",
    "八角，香叶，桂皮，茴香，冰糖，自己没有这么多食材可以买现成的卤料包",
    "常规做法的卤汁渗透速度慢，内部味道容易偏淡。想入味更快、切面更好看：剥壳 → 在蛋白侧面划 3–11 刀（上下十字方向，接近蛋黄即可，别太深以免蛋黄散出）→ 放入小容器，卤汁没过鸡蛋 → 浸泡 2 天以上"
  ],
  "description": "茶香浓郁，鲜香可口的高蛋白快速营养早餐，大约耗时 30 分钟。烹饪略微耗时，可以周末尝试，做一次大约够 2-3 个人吃。"
