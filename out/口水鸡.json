  "steps": [
    {
      "content": "姜切片，1 颗小葱，15 颗花椒备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸡肉洗干净，放入锅中，清水没过鸡肉，放入姜片、小葱和花椒，开大火烧开。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火烧开后，转中小火 20 分钟关火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出鸡肉，放入冰水中，直至冰凉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出鸡肉，切块摆盘子中，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "小火把锅烧热，导入花生，烘烤至表皮爆裂。（注意随时翻动，不要糊了）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "一颗葱切成段，蒜拍成末，花椒 15 颗，花生去皮切碎。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "锅内导入油烧热后，放入葱段，花椒和一半蒜末，炒香",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "炒至油温 8 成热，关火，滤出热油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将热油倒入放辣椒粉的碗中，搅拌，并滤出红油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "红油中放入剩余蒜末、生抽、醋、盐、味精、糖、香油、花椒粉。拌匀放凉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "在鸡肉上撒上花生碎，把红油淋到切好的鸡肉上，撒上香菜。成盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "口水鸡（凉菜），炎炎夏日里，热菜难以入口，但又嗜肉如命，\n除了口水鸡，实在想不出更好的适合在夏天吃的肉菜了。\n被红油包裹的鸡肉，红艳鲜亮，冰爽 Q 弹，鲜美而不腻。夏日米饭杀手当之无愧!"
}