  "steps": [
    {
      "content": "姜蒜准备好，切碎",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "干辣椒切碎，和姜蒜一起",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入 30-50ml 油，等待锅热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入擦干水分的鱼（不想被热油溅一身的话），然后晃动锅，用热油煎鱼，注意这过程一定要小火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将鱼翻面，重复上面油煎过程",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入姜蒜辣椒，翻炒出香味",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "倒入料酒，稍微多一点，",
      "duration_minutes": null,
      "tips": "此过程注意安全，会起大量油烟"
    },
    {
      "content": "倒入醋",
      "duration_minutes": null,
      "tips": "喜欢醋可以多放一点"
    },
    {
      "content": "然后放入白砂糖，酱油（老抽)",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入冷水，以刚好淹没鱼身为宜，然后调成中火，盖上锅盖，大概 1 分钟后将鱼翻身，继续盖上锅盖",
      "duration_minutes": 5.0,
      "tips": ""
    },
    {
      "content": "3-4 分钟后，加入盐、小米椒、蚝油（味精、鸡精等），然后继续盖上锅盖，后续继续要翻身",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "当锅内汤汁收汁到鱼的脊背线上的鱼鳍下面一点点的时候（或者汤汁不多的时候），转小火，加入香菜，葱花，然后盖上锅盖 20 秒，关火",
      "duration_minutes": 0.33,
      "tips": ""
    },
    {
      "content": "起锅",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "WARNING 如果没有使用过菜刀剁过肉类食物，那么并不推荐使用该菜单！！！",
    "在操作中，锋利的菜刀可能会划伤手指，请一定要小心",
    "此做法代表通用红烧鱼做法，材料分为必备和可添加~",
    "注意可额外添加的材料都是经验计算得出，除了香菜外其他多了并不是一件好事儿"
  ],
