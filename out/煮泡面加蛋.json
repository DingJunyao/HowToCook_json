  "steps": [
    {
      "content": "先将水加热至沸腾",
      "duration_minutes": null,
      "tips": "火候不做严格要求，使用热水会更快"
    },
    {
      "content": "将取出的面饼放入锅中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将泡面里附带的佐料放入锅中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出筷子轻微拨动泡面，使佐料充分溶解，面饼充分浸泡受热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "盖上锅盖等待约 1 分钟至锅内水再次沸腾",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "去壳鸡蛋，加入锅中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "等待约 3 至 4 分钟，即可",
      "duration_minutes": null,
      "tips": ""
    }
