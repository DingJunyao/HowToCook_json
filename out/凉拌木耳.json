  "steps": [
    {
      "content": "泡发干木耳，水量约为 400ml，泡发约 45 分钟。",
      "duration_minutes": null,
      "tips": "湿木耳跳过此步骤"
    },
    {
      "content": "将泡发好的木耳，进行去根处理，并彻底洗净。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧水，水开后放入木耳，大火煮 1.5-2 分钟。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将蒜瓣、小米辣切碎放入碗中 （可选取中大碗），并依次加入盐、糖、生抽、醋、香油、芥末，用量如上。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "木耳盛出后沥水，放入上一步碗中。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "搅拌充分，端盘。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "调味品的数量可以根据个人口味进行调整，如果不喜欢芥末，可以不加入。",
    "等木耳冷却入味后口味更佳，约 15 分钟。"
  ],
  "description": "凉拌木耳，由于发放物资中有很多干货，木耳是较为健康的食物。且凉拌木耳的烹饪方式也相对简单。"
