  "steps": [
    {
      "content": "加入以下食材，注意不要超过容器的 3/4",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "挖半个鸡蛋大的黄油放进容器, 在微波炉加热 15 秒至融化",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将巧克力/香蕉 融化/搅碎成 颗粒/糊状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "打入一个鸡蛋并打散搅和",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "15g 白（红）糖",
      "duration_minutes": null,
      "tips": "甜党可以多加些"
    },
    {
      "content": "加入 1g 盐",
      "duration_minutes": null,
      "tips": "如果后续的口味食材含盐需自己斟酌"
    },
    {
      "content": "加入 2.5g 泡打粉",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入 15g 面粉",
      "duration_minutes": null,
      "tips": "筋度没太大影响"
    },
    {
      "content": "加入任何喜欢的口味食材!",
      "duration_minutes": null,
      "tips": "坚果与饼干等干食材不是现在放"
    },
    {
      "content": "搅和至看不见干粉的稠酸奶状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入可选的干燥食材（不包括冲泡粉）在顶端",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "微波炉（高火）加热 1分钟（至蓬松蛋糕形态）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "取出杯子并拍朋友圈就可以吃了",
      "duration_minutes": null,
      "tips": "烫手啊啊啊啊↑"
    }
  ],
  "tips": [
    "在夸赞自己之前的操作可以重复多遍做出更大的蛋糕",
    "泡打粉用来让蛋糕更蓬松 大多不含铝 几块钱一包 可以买了在家备着",
    "在 加入任何喜欢的口味食材 这一步骤中 若加入液体（如牛奶） 请务必确保下一步可以搅和成稠酸奶状 建议少量多次加入以防止水分过量而导致成品湿瘪",
    "食材不要超过容器的3/4!!"
  ],
  "description": ""
