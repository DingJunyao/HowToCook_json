  "steps": [
    {
      "content": "将酱油、孜然、食用盐、蒜蓉和切碎的小米椒置于碗中，均匀搅拌备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "茄子洗净，用纸巾擦干表面的水分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用叉子在茄子的一侧扎 4-8 下",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "使用 15-25ml 的食用油涂满茄子表面",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将烤箱温度设置为 200℃ （打开烤箱风扇 大火），预热 2 分钟",
      "duration_minutes": 2.0,
      "tips": ""
    },
    {
      "content": "将茄子放入烤箱中层或者上层，烤制 12-15 分钟 （茄子表面有褶皱，且能按压 0.3-0.5cm 的深度即可）",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "取出茄子，用刀茄子上竖着划一个口子。口子居中，上下距 1-1.5cm",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "用小刀或者叉子伸入口子，竖着切割茄子内部",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将口子微微掰开，倒入第一步准备的酱料",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "再次将茄子放入烤箱，将烤箱温度设置为 200℃ ，烤制 4-7 分钟",
      "duration_minutes": 7.0,
      "tips": ""
    },
    {
      "content": "取出，关闭烤箱电源",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "最终成品和楼下烧烤摊的烤茄子差不多，太香了！",
    "茄子表面有水分、未涂满食用油或未使用叉子扎孔可能导致茄子在烤制的过程中爆裂",
    "第一次用刀划口子的时候，可以直接将茄子竖直切成两半，然后切割出纹路后涂抹上酱料"
  ],
  "description": "非常简单方便，而且香极了"
}