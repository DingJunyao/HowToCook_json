      "tips": ""
    },
    {
      "content": "培根片包裹鸡蛋",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "手抓饼两端切除以矩形包裹鸡蛋",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "油温 6 成下锅，炸制金黄即可",
      "duration_minutes": null,
      "tips": "油面波动，有青烟，筷子插入油中周围泛起气泡即是 6 成温度"
    },
    {
      "content": "空气炸锅 160 度 15 分钟",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "切开即可食用",
      "duration_minutes": null,
