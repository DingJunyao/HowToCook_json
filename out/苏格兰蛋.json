  "steps": [
    {
      "content": "用冷水下锅水开 3 分钟后捞出",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "鸡蛋捞出，放入冰水中剥壳更快速也更完整",
      "duration_minutes": null,
      "tips": ""
    },
