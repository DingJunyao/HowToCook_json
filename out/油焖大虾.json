  "steps": [
    {
      "content": "剪虾枪到根上，虾须虾爪都剪掉，沙包挑掉，开背虾线挑出来，洗净备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "炸料油：油温三成热放花椒，油热离火，放葱姜（不要让油变色最好）葱稍微变黄沥油 （葱油弄多了可以留着作为拌面使用）。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "下油，虾摆放整齐，两面变色后轻轻摁虾头",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放姜米（姜切成细颗粒）、黄酒 30g、水两小碗、盐 3g、冰糖 10 克",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大火烧开转小火盖盖子闷（中途不能再加汤水，不要开盖）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "皮亮虾弯就可以起锅，虾摆盘",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "收汁（过滤后倒回锅里收浓，放葱油 ） 汤汁剩余 1/4 时，浇汁",
      "duration_minutes": null,
      "tips": ""
    }
  ],
