  "steps": [
    {
      "content": "洋葱剥去外层去芯，切成月牙状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "葱洗净切成 0.5cm 的小段",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅直接放入白芝麻，前后晃动锅体使芝麻均匀受热至略呈金黄色",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "肥牛焯水 1 分钟后捞出",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "将 40g 味淋（或 30g 料酒），30g 酱油，20g 耗油，5g 糖，5g 老抽（可选，用于调色），在碗中搅拌混合成调料",
      "duration_minutes": null,
      "tips": "该步骤可直接将碗放在电子秤上进行"
    },
    {
      "content": "热油锅放入洋葱，快速翻炒至洋葱变透明状",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "关小火，加入 250g 水（或出汁），开回大火加热等待 3 分钟",
      "duration_minutes": 3.0,
      "tips": ""
    },
    {
      "content": "加入牛肉和调料",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "不断翻动所有食材 10 分钟，防止食材粘锅",
      "duration_minutes": 10.0,
      "tips": ""
    },
    {
      "content": "关火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "盛装肥牛丼至米饭上（注意要把汁水淋一些在饭上）",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "撒上葱花和白芝麻，制作完成。",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "冷藏的牛丼每次取出需要吃的份量，加热后盖在米饭上。微波炉：单人份高火 2-3 分钟；锅：需额外加 50ml 水，加热时需不断翻动",
      "duration_minutes": 3.0,
      "tips": ""
    }
  ],
  "tips": [
    "食材用量与米饭成正比，计算部分以 一杯米(160ml) 为例。约为二人食用分量",
    "如果用的是比较不错的牛肉，可以选择不焯水，能够更加保留牛肉的风味",
    "因为加入了味淋所以不会很腥，无需担心牛肉不熟，加热10分钟肯定熟了",
    "如果有条件，选择加入清酒提鲜"
  ],
  "description": ""
