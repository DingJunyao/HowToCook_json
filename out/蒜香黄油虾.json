  "steps": [
    {
      "content": "大虾去头去壳留尾，用牙签挑去虾线，洗净后用厨房纸吸干水分",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "大蒜切成蒜末，备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "中火加热平底锅，放入 10ml 橄榄油",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "油热后放入大虾，每面煎 1-1.5 分钟至变色，取出备用",
      "duration_minutes": 1.5,
      "tips": ""
    },
    {
      "content": "同一锅中加入黄油，融化后放入蒜末，小火炒香",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "如使用白葡萄酒，此时加入并煮至酒精挥发",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "将虾放回锅中，与蒜香黄油酱汁翻炒均匀",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "挤入柠檬汁，翻炒均匀后立即关火",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "装盘，淋上锅中剩余酱汁",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [
    "虾不宜过度烹饪，否则会变硬"
  ],
  "description": "蒜香黄油虾是一道经典的西式海鲜料理，以鲜虾为主料，配以蒜末和黄油烹制而成。口感鲜嫩，蒜香浓郁。制作简单，适合家庭日常烹饪。"
