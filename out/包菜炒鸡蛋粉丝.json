  "steps": [
    {
      "content": "胡萝卜、包菜切丝备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "粉丝先用冷水浸泡 1 小时，然后将粉丝放入锅中，加入开水烧至粉丝烫软捞出备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸡蛋打入碗中，加入盐后搅拌 15 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "葱、蒜、辣椒切成小粒备用",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "起锅烧油，倒入鸡蛋，打散炒熟盛出",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "再倒入油，放入葱、蒜、干辣椒翻炒 8 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "下胡萝卜、包菜丝儿翻炒 30 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入粉丝",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放调料，生抽 15 ml，老抽 10 ml，蚝油 10 ml，盐 2 克",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "放入之前炒好的鸡蛋，翻炒约 15 秒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "出锅摆盘",
      "duration_minutes": null,
      "tips": ""
    }
  ],
