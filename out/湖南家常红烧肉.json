  "steps": [
    {
      "content": "带皮五花肉洗净冷水下锅，加入姜片 2~3 片去腥味，煮到沸腾捞出冷水冲净白沫",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "五花肉切块，尺寸 1.5cm*1.5cm 块状大小",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "热锅加入油，加入冰糖小火搅拌至焦糖色即可，加入切好的五花肉，中火翻炒上色",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "加入备好的姜片、八角、桂皮、生抽、老抽、料酒、干小米椒、盐，小火翻炒 1 分钟，加开水没过肉",
      "duration_minutes": 1.0,
      "tips": ""
    },
    {
      "content": "加盖中火煮沸，转小火慢顿 30 分钟，慢炖期间，间隔 10 分钟搅拌一次防止粘锅",
      "duration_minutes": 30.0,
      "tips": ""
    },
    {
      "content": "小火慢炖汤汁剩三分之一的时，调成中火收汁出锅。",
      "duration_minutes": null,
      "tips": ""
    }
  ],
  "tips": [],
  "description": "湖南家常红烧肉，入口软糯，肥而不腻"
