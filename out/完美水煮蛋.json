  "steps": [
    {
      "content": "准备两锅水： A 锅维持 100°C 沸水， B 锅维持 30°C 温水",
      "duration_minutes": null,
      "tips": "锅直径≥ 15cm"
    },
    {
      "content": "用漏勺将鸡蛋放入 A 锅，启动定时器",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "精准每 2 分钟将鸡蛋转移至另一锅水",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "重复转移操作共 16 次（总时长 32 分钟）",
      "duration_minutes": 32.0,
      "tips": ""
    },
    {
      "content": "最后一次转移后，在 B 锅静置 30 秒",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "立即放入冰水（ 0 摄氏度）终止加热（维持 30 秒）",
      "duration_minutes": 0.5,
      "tips": ""
    },
    {
      "content": "剥壳时从钝端气室处开始，沿纵轴剥离蛋膜",
      "duration_minutes": null,
