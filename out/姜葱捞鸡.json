  "steps": [
    {
      "content": "四个鸡腿清洗干净，放入碗中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "碗中加入盐焗鸡粉和 5ml 油，搅拌均匀",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "让鸡腿静置腌制 15 分钟， 同时准备蒸锅并把水煮开",
      "duration_minutes": 15.0,
      "tips": ""
    },
    {
      "content": "鸡腿腌制完成后， 放入水开后的蒸锅中，蒸制 20 分钟",
      "duration_minutes": 20.0,
      "tips": ""
    },
    {
      "content": "将姜根据个人口味切成 1）姜蓉或 2）姜丝或 3）姜粒",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将葱切成 0.5cm 小段",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将葱姜放入蘸料碗，并加入盐和糖",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将剩余的油倒入另一个锅中加热至六至七层热",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "将热油淋入葱姜碗中",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "鸡腿蒸好后将其撕碎成鸡丝，不需要特别细，大概 1cm 粗就可以",
      "duration_minutes": null,
      "tips": ""
    },
    {
      "content": "姜葱姜油淋在鸡丝上，搅拌均匀即可",
      "duration_minutes": null,
      "tips": ""
    }
  ],
